ndex="5" value="300"/><column index="6" value="85"/><column index="7" value="111"/><column index="8" value="66"/><column index="9" value="199"/><column index="10" value="199"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="vehiculos" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="94"/><column index="3" value="87"/><column index="4" value="77"/><column index="5" value="71"/><column index="6" value="115"/><column index="7" value="132"/><column index="8" value="66"/><column index="9" value="106"/><column index="10" value="199"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="videos" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="39"/><column index="2" value="94"/><column index="3" value="279"/><column index="4" value="199"/><column index="5" value="107"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">/*SELECT r.id, r.servicio_id FROM repostajes r LEFT JOIN servicios s ON r.servicio_id = s.id WHERE s.id IS NULL;*/
/*SELECT r.id AS repostaje_id, r.servicio_id, s.vehiculo_id FROM repostajes r INNER JOIN servicios s ON r.servicio_id = s.id WHERE s.vehiculo_id IS NULL;*/
/*SELECT r.id AS repostaje_id, r.servicio_id, s.conductor_id FROM repostajes r INNER JOIN servicios s ON r.servicio_id = s.id WHERE s.conductor_id IS NULL;*/
/*SELECT origen_id, destino_id, vehiculo_id, marca FROM servicios INNER JOIN vehiculos ON vehiculo_id = vehiculos.id*/
SELECT servicios.id, servicios.fecha_entrega, servicios.fecha_cancelacion, servicios.conductor_id, vehiculos.marca, vehiculos.modelo, vehiculos.matricula, origen.nombre AS origen, destino.nombre AS destino, estado_servicio.estado, usuarios.nombre, usuarios.apellido, solicitudes_cancelacion.estado_id AS estado_solicitud_cancelacion FROM servicios INNER JOIN vehiculos ON servicios.vehiculo_id = vehiculos.id INNER JOIN concesionarios AS origen ON servicios.origen_id = origen.id INNER JOIN concesionarios AS destino ON servicios.destino_id = destino.id INNER JOIN estado_servicio ON servicios.estado_id = estado_servicio.id LEFT JOIN usuarios ON servicios.conductor_id = usuarios.id LEFT JOIN solicitudes_cancelacion ON servicios.id = solicitudes_cancelacion.servicio_id</sql><current_tab id="0"/></tab_sql></sqlb_project>
